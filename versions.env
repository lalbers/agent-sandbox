# Pinned versions for `sbx build`. Plain KEY=VALUE lines, no shell syntax.
# To update: change the values (and the matching SHA-256), then `sbx build`.

FEDORA_IMAGE=registry.fedoraproject.org/fedora:44
CLAUDE_CODE_VERSION=2.1.309

REA_VERSION=6.7.0

# REA accepts Ghidra 12.1.x only (verified with 12.1.4 + JDK 21).
GHIDRA_VERSION=12.1.4
GHIDRA_URL=https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_12.1.4_build/ghidra_12.1.4_PUBLIC_20260921.zip
GHIDRA_SHA256=ddac49f903da9d5bac833e5cc79395098b9c33cfd3279be5f31bd00387d2d4db

# mitmproxy: REA decodes native .mitm captures with exactly mitmdump 12.2.3.
# The hash is PyPI's for the wheel; dependencies are resolved at build time.
MITMPROXY_VERSION=12.2.3
MITMPROXY_WHEEL_SHA256=df75ccd15ccb39ab55ce9dd4130312270e8ba208eb927a7cbe50cb52678ec722

# Temurin JDK 21 (Fedora 44 only ships JDK 25).
JDK_URL=https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.13%2B9/OpenJDK21U-jdk_x64_linux_hotspot_21.0.13_9.tar.gz
JDK_SHA256=d7f5d5cf865a2902b70ff549b97586a7d3f234e016f041ab447ea740c7d66d1c
