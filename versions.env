# Pinned versions for `sbx build`. Plain KEY=VALUE lines, no shell syntax.
# To update: change the values (and the matching SHA-256), then `sbx build`.

# Base image pinned by the digest of its multi-arch index; the images still run
# `dnf -y update`, so this fixes the starting point, not the package versions.
FEDORA_IMAGE=registry.fedoraproject.org/fedora:44@sha256:9e6aa1917e422110bac3ee401f2b53ac4ade82f815b442a6a31164822fde88f9
CLAUDE_CODE_VERSION=2.1.328

# Official Node.js build (REA 6.9 needs ^22.23.4 || ^24.22.1 || >=26.12.1;
# Fedora 44 ships 24.18). Hash from the release-key-signed SHASUMS256.txt.
NODE_VERSION=24.22.3
NODE_SHA256=4f2b175a6d53a5c617a80dba2676238a0688cef28c6da4eba35c7d844e66fcfb

REA_VERSION=6.9.0

# REA verifies its Ghidra bridge with 12.1.4 + JDK 21 (newer 12.x run as unverified).
GHIDRA_VERSION=12.1.4
GHIDRA_URL=https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_12.1.4_build/ghidra_12.1.4_PUBLIC_20260921.zip
GHIDRA_SHA256=ddac49f903da9d5bac833e5cc79395098b9c33cfd3279be5f31bd00387d2d4db

# mitmproxy: REA decodes native .mitm captures with exactly mitmdump 12.2.3.
# The hash is PyPI's for the wheel; dependencies are resolved at build time.
MITMPROXY_VERSION=12.2.3
MITMPROXY_WHEEL_SHA256=df75ccd15ccb39ab55ce9dd4130312270e8ba208eb927a7cbe50cb52678ec722

# Temurin JDK 21 (Fedora 44 only ships JDK 25).
JDK_URL=https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.13.1%2B2/OpenJDK21U-jdk_x64_linux_hotspot_21.0.13.1_2.tar.gz
JDK_SHA256=bb8a93f9ae6e7a693b2b721e85dbeff26ae1a77447985a8d7afcdd9c7cf6222e
