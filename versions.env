# Pinned versions for `sbx build`. Plain KEY=VALUE lines, no shell syntax.
# To update: change the values (and the matching SHA-256), then `sbx build`.

# Base image pinned by the digest of its multi-arch index; the images still run
# `dnf -y update`, so this fixes the starting point, not the package versions.
FEDORA_IMAGE=registry.fedoraproject.org/fedora:44@sha256:c1e457a3c398b0d7b12d060ad86ad52bab714a17faecc907deb1262fb2b72d98
CLAUDE_CODE_VERSION=2.1.332

# Official Node.js build (REA 6.10 needs ^22.23.4 || ^24.22.1 || >=26.12.1;
# Fedora 44 ships 24.18). Hash from the release-key-signed SHASUMS256.txt.
NODE_VERSION=24.22.3
NODE_SHA256=4f2b175a6d53a5c617a80dba2676238a0688cef28c6da4eba35c7d844e66fcfb

REA_VERSION=6.10.1

# REA 6.10 needs Ghidra 12.2 or a newer 12.x and a JDK in that build's range
# (verified: 12.2 + JDK 25; Ghidra 12.2 itself requires Java 25 or newer).
GHIDRA_VERSION=12.2
GHIDRA_URL=https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_12.2_build/ghidra_12.2_PUBLIC_20261016.zip
GHIDRA_SHA256=2c2cd776db3c1f6a097ba418922378ac3649cadd5e844a6f5f088ae628a7be67

# mitmproxy: REA decodes native .mitm captures with exactly mitmdump 12.2.3.
# The hash is PyPI's for the wheel; dependencies are resolved at build time.
MITMPROXY_VERSION=12.2.3
MITMPROXY_WHEEL_SHA256=df75ccd15ccb39ab55ce9dd4130312270e8ba208eb927a7cbe50cb52678ec722

# Temurin JDK 25, pinned by checksum (Fedora's JDK 25 package is not pinned).
JDK_URL=https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.5.1%2B2/OpenJDK25U-jdk_x64_linux_hotspot_25.0.5.1_2.tar.gz
JDK_SHA256=760f91b22c3efc9bd1b64ff950598231be82928cc807e30691a0e7a2995a62c0
