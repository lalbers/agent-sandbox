#!/bin/bash
# Prepare the persistent home (state/home on the host) and run the container
# command (default `sleep infinity`, so the host CLI can `podman exec` into
# the running sandbox).
set -euo pipefail

skel=/opt/claude-sbx/skel
[ "$HOME" = /home/agent ] || { echo "sbx-entrypoint: unexpected HOME=$HOME" >&2; exit 1; }

# At the start of a session (sbx sets SBX_RESET_HOME=1 for the container and
# for the first microVM run) only Claude's conversation transcripts survive,
# for --resume. Everything else a hostile sample could have left for a later
# session to run or obey goes: settings and hooks, CLAUDE.md, skills, agents,
# auto memory, shell startup files, npm/pip caches. Not on every microVM run:
# those may overlap with a running one.
reset_home() {
    local p=$HOME/.claude/projects d
    # A directory locked with chmod must not make the reset (and the start) fail.
    chmod -R u+rwX -- "$HOME" 2>/dev/null || true
    find "$HOME" -mindepth 1 -maxdepth 1 ! -name .claude -exec rm -rf -- {} +
    if [ -L "$HOME/.claude" ] || [ ! -d "$HOME/.claude" ]; then
        rm -rf -- "$HOME/.claude"
        return
    fi
    find "$HOME/.claude" -mindepth 1 -maxdepth 1 ! -name projects -exec rm -rf -- {} +
    if [ -L "$p" ] || [ ! -d "$p" ]; then
        rm -rf -- "$p"
        return
    fi
    # projects/<project>/<session>.jsonl stays, and so does the matching
    # <session>/ directory (subagent transcripts, tool results) that resume
    # needs; nothing else, and no symlinks or special files anywhere below.
    find "$p" -mindepth 1 -maxdepth 1 ! -type d -exec rm -rf -- {} +
    for d in "$p"/*/; do
        [ -d "$d" ] || continue
        find "$d" -mindepth 1 -maxdepth 1 -print0 | while IFS= read -r -d '' e; do
            case $e in
                *.jsonl) [ -f "$e" ] && [ ! -L "$e" ] && continue ;;
                *) [ -d "$e" ] && [ ! -L "$e" ] && [ -f "$e.jsonl" ] && continue ;;
            esac
            rm -rf -- "$e"
        done
    done
    find "$p" -mindepth 3 ! -type f ! -type d -exec rm -f -- {} +
}

if [ "${SBX_RESET_HOME:-}" = 1 ]; then
    reset_home
fi
cp -R "$skel/." "$HOME/"
[ -f "$HOME/.claude.json" ] || cp /opt/claude-sbx/claude.json "$HOME/.claude.json"

# In a microVM the guest kernel does not apply the container's confinement;
# sbx-guard sets no_new_privs and a seccomp filter before the command runs.
if [ -n "${SBX_VM:-}" ]; then
    exec /usr/local/bin/sbx-guard "$@"
fi
exec "$@"
