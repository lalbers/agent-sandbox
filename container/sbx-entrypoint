#!/bin/bash
# Reset the persistent home (state/home on the host) to the image skeleton,
# then run the container command (default `sleep infinity`, so the host CLI
# can `podman exec` into the running sandbox).
set -euo pipefail

skel=/opt/claude-sbx/skel
[ "$HOME" = /home/agent ] || { echo "sbx-entrypoint: unexpected HOME=$HOME" >&2; exit 1; }

# Only Claude's conversation transcripts survive from one start to the next
# (for --resume). Everything else a hostile sample could have left for a later
# session to run or obey goes: settings and hooks, CLAUDE.md, skills, agents,
# auto memory, shell startup files, npm/pip caches.
find "$HOME" -mindepth 1 -maxdepth 1 ! -name .claude -exec rm -rf -- {} +
if [ -d "$HOME/.claude" ] && [ ! -L "$HOME/.claude" ]; then
    find "$HOME/.claude" -mindepth 1 -maxdepth 1 ! -name projects -exec rm -rf -- {} +
    if [ -d "$HOME/.claude/projects" ] && [ ! -L "$HOME/.claude/projects" ]; then
        find "$HOME/.claude/projects" -mindepth 1 -maxdepth 1 ! -type d -exec rm -rf -- {} +
        find "$HOME/.claude/projects" -mindepth 2 \( ! -name '*.jsonl' -o ! -type f \) -prune -exec rm -rf -- {} +
    else
        rm -rf -- "$HOME/.claude/projects"
    fi
else
    rm -rf -- "$HOME/.claude"
fi

cp -R "$skel/." "$HOME/"
cp /opt/claude-sbx/claude.json "$HOME/.claude.json"

# In a microVM the guest kernel does not apply the container's confinement;
# sbx-guard sets no_new_privs and a seccomp filter before the command runs.
if [ -n "${SBX_VM:-}" ]; then
    exec /usr/local/bin/sbx-guard "$@"
fi
exec "$@"
